# PostgreSQL (Neon, Supabase ou serviço PostgreSQL com TLS)
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
# Definir apenas no Vercel (Environment Variables), nunca versionar a senha.
ADMIN_INITIAL_PASSWORD=
# Opcional; reservado em código ao único administrador principal.
ADMIN_USERNAME=pm-civil.bandeira

# Gemini: segredo somente no servidor, sem prefixo NEXT_PUBLIC_
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional: GitHub Actions pode sincronizar secrets.GEMINI_API_KEY com a Vercel.
# VERCEL_TOKEN é exclusivo do GitHub Secrets, não é necessário na aplicação.


# Anexos: conectar um Vercel Blob PRIVATE no ambiente de homologação/produção.
# O SDK usa BLOB_STORE_ID + OIDC ou BLOB_READ_WRITE_TOKEN (apenas servidor).
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Hosts HTTPS exatos autorizados para IMPORTAR imagens; vazio bloqueia importação externa.
# A imagem é validada e copiada para Blob privado; o navegador não acessa esses hosts.
DOC_IMAGE_IMPORT_HOSTS=
